#!/bin/bash
#ddev-generated

## Description: Remove a DDEV worktree clone created by 'ddev worktree'
## Usage: worktree-remove <name> [flags]
## Example: ddev worktree-remove feature-branch\nddev worktree-remove --list\nddev worktree-remove --path=../my-site-from-ide
## Flags: [{"Name":"list","Type":"bool","Usage":"List all worktree clones for this project"},{"Name":"path","Type":"string","Usage":"Remove the DDEV setup from a worktree adopted with 'ddev worktree --path'"}]

set -euo pipefail

# ── Helpers ──────────────────────────────────────────────────────────────────

die() { printf "\033[31mError:\033[0m %b\n" "$1" >&2; exit 1; }
info() { printf "\033[34m→\033[0m %s\n" "$1"; }
success() { printf "\033[32m✓\033[0m %s\n" "$1"; }
warn() { printf "\033[33m!\033[0m %s\n" "$1"; }

# Must match sanitize_name in the worktree command.
sanitize_name() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's|[^a-z0-9-]|-|g; s|-\{2,\}|-|g; s|^-||; s|-$||'
}

# Sanitizer used up to v1.1.2 (kept "_", "." and uppercase). Clones created
# by those versions live under these names, so removal still tries it.
legacy_sanitize_name() {
    printf '%s' "$1" | sed 's|[/\\]|-|g; s|[^a-zA-Z0-9._-]|-|g; s|-\{2,\}|-|g; s|^-||; s|-$||'
}

is_omit_project_name_enabled() {
    local global_config="$HOME/.ddev/global_config.yaml"
    [[ -f "$global_config" ]] && grep -q '^omit_project_name_by_default: true' "$global_config"
}

is_git_worktree() {
    local dir="$1" source_dir="$2"
    git -C "$source_dir" worktree list 2>/dev/null | grep -q "$(cd "$dir" 2>/dev/null && pwd)"
}

# Echoes the worktree marker config in $1/.ddev, or nothing if absent.
# config.worktree.yaml is the pre-v1.1.0 name, still honored so worktrees
# created by older versions remain removable.
worktree_config() {
    local ddev_dir="${1%/}/.ddev"
    local candidate
    for candidate in "${ddev_dir}/config.worktree.local.yaml" "${ddev_dir}/config.worktree.yaml"; do
        if [[ -f "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

# Succeeds if the config file $1 marks a worktree adopted with --path,
# whose files belong to the tool that created it.
is_managed_externally() {
    grep -q '^# managed-by: external' "$1" 2>/dev/null
}

config_project_name() {
    grep -E '^name:' "$1" 2>/dev/null | head -1 | sed 's/^name:[[:space:]]*//'
}

# Echoes the linked worktrees of the source repo, one path per line.
linked_worktrees() {
    local main wt
    main=$(cd "$SOURCE_DIR" && pwd -P)
    while IFS= read -r wt; do
        [[ "$(cd "$wt" 2>/dev/null && pwd -P)" == "$main" ]] || echo "$wt"
    done < <(git -C "$SOURCE_DIR" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
}

# Echoes the adopted worktree whose project is named $1, or nothing.
find_adopted_worktree() {
    local wt cfg
    while IFS= read -r wt; do
        cfg="${wt%/}/.ddev/config.worktree.local.yaml"
        if is_managed_externally "$cfg" && [[ "$(config_project_name "$cfg")" == "$1" ]]; then
            echo "$wt"
            return 0
        fi
    done < <(linked_worktrees)
    return 1
}

# ── Arg parsing ──────────────────────────────────────────────────────────────

NAME=""
LIST_MODE=false
ADOPT_PATH=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --list)  LIST_MODE=true; shift ;;
        --path=*) ADOPT_PATH="${1#--path=}"; shift ;;
        --path)  ADOPT_PATH="${2:-}"; shift 2 ;;
        -*)      die "Unknown flag: $1" ;;
        *)
            if [[ -z "$NAME" ]]; then
                NAME="$1"
            else
                die "Unexpected argument: $1"
            fi
            shift
            ;;
    esac
done

# ── Resolve source project ──────────────────────────────────────────────────

SOURCE_DIR="$(pwd)"
SOURCE_DDEV_DIR="${SOURCE_DIR}/.ddev"

[[ -d "$SOURCE_DDEV_DIR" ]] || die "This does not appear to be a DDEV project (no .ddev/ directory)"

SOURCE_PROJECT=$(yq eval '.name // ""' "${SOURCE_DDEV_DIR}/config.yaml" 2>/dev/null || grep -E '^name:' "${SOURCE_DDEV_DIR}/config.yaml" 2>/dev/null | head -1 | sed 's/^name:[[:space:]]*//')
[[ -n "$SOURCE_PROJECT" ]] || die "Could not determine project name from .ddev/config.yaml"

SOURCE_DIRNAME=$(basename "$SOURCE_DIR")
PARENT_DIR=$(dirname "$SOURCE_DIR")

# ── List mode ────────────────────────────────────────────────────────────────

if $LIST_MODE; then
    echo "Worktree clones for project '${SOURCE_PROJECT}':"
    echo ""
    found=0
    for dir in "${PARENT_DIR}/${SOURCE_DIRNAME}-"*/; do
        [[ -d "$dir" ]] || continue
        if config_wt=$(worktree_config "$dir"); then
            is_managed_externally "$config_wt" && continue  # listed below
            wt_name=$(grep -E '^name:' "$config_wt" 2>/dev/null | head -1 | sed 's/^name:[[:space:]]*//')
            if [[ "$wt_name" == "${SOURCE_PROJECT}-"* ]]; then
                suffix="${wt_name#${SOURCE_PROJECT}-}"
                status="stopped"
                if ddev describe -j "$wt_name" 2>/dev/null | grep -q '"status":"running"' 2>/dev/null; then
                    status="running"
                fi
                printf "  %-30s %-12s %s\n" "$suffix" "($status)" "$dir"
                found=$((found + 1))
            fi
        elif is_git_worktree "$dir" "$SOURCE_DIR"; then
            wt_name=$(basename "${dir%/}")
            suffix="${wt_name#${SOURCE_DIRNAME}-}"
            status="stopped"
            if ddev describe -j "$wt_name" 2>/dev/null | grep -q '"status":"running"' 2>/dev/null; then
                status="running"
            fi
            printf "  %-30s %-12s %s\n" "$suffix" "($status)" "$dir"
            found=$((found + 1))
        fi
    done
    # Worktrees adopted with --path can live anywhere.
    while IFS= read -r dir; do
        cfg="${dir%/}/.ddev/config.worktree.local.yaml"
        is_managed_externally "$cfg" || continue
        wt_name=$(config_project_name "$cfg")
        [[ "$wt_name" == "${SOURCE_PROJECT}-"* ]] || continue
        suffix="${wt_name#${SOURCE_PROJECT}-}"
        status="stopped"
        if ddev describe -j "$wt_name" 2>/dev/null | grep -q '"status":"running"' 2>/dev/null; then
            status="running"
        fi
        printf "  %-30s %-12s %s (external)\n" "$suffix" "($status)" "$dir"
        found=$((found + 1))
    done < <(linked_worktrees)
    if [[ $found -eq 0 ]]; then
        echo "  (none found)"
    fi
    echo ""
    exit 0
fi

# ── Remove mode ──────────────────────────────────────────────────────────────

[[ -n "$NAME" || -n "$ADOPT_PATH" ]] || die "Usage: ddev worktree-remove <name> [--list] [--path=DIR]"

SANITIZED=""
TARGET_DIR=""
if [[ -n "$ADOPT_PATH" ]]; then
    [[ -d "$ADOPT_PATH" ]] || die "Directory not found: ${ADOPT_PATH}"
    TARGET_DIR=$(cd "$ADOPT_PATH" && pwd -P)
    CFG=$(worktree_config "$TARGET_DIR") || die "${TARGET_DIR} has no .ddev/config.worktree.local.yaml — it was not set up by 'ddev worktree'."
    TARGET_PROJECT=$(config_project_name "$CFG")
    SANITIZED="${TARGET_PROJECT#${SOURCE_PROJECT}-}"
else
    TRIED=()
    for candidate in "$(sanitize_name "$NAME")" "$(legacy_sanitize_name "$NAME")"; do
        [[ -n "$candidate" ]] || continue
        TRIED+=("${PARENT_DIR}/${SOURCE_DIRNAME}-${candidate}")
        if [[ -d "${PARENT_DIR}/${SOURCE_DIRNAME}-${candidate}" ]]; then
            SANITIZED="$candidate"
            TARGET_DIR="${PARENT_DIR}/${SOURCE_DIRNAME}-${candidate}"
            break
        fi
    done
    if [[ -z "$TARGET_DIR" ]] && SANITIZED=$(sanitize_name "$NAME") && [[ -n "$SANITIZED" ]]; then
        TARGET_DIR=$(find_adopted_worktree "${SOURCE_PROJECT}-${SANITIZED}" || true)
    fi
    [[ -n "$TARGET_DIR" ]] || die "Directory not found: ${TRIED[0]:-${PARENT_DIR}/${SOURCE_DIRNAME}-}\nRun 'ddev worktree-remove --list' to see existing clones."
    TARGET_PROJECT="${SOURCE_PROJECT}-${SANITIZED}"
fi

# Safety check: verify this was created by 'ddev worktree'
if ! CONFIG_WORKTREE=$(worktree_config "$TARGET_DIR"); then
    if is_git_worktree "$TARGET_DIR" "$SOURCE_DIR"; then
        info "No config.worktree.local.yaml — verified as git worktree of this project"
    else
        die "Safety check failed: ${TARGET_DIR} does not contain .ddev/config.worktree.local.yaml and is not a recognized git worktree.\nThis directory was not created by 'ddev worktree' — refusing to remove."
    fi
fi

# Adopted worktree: the files belong to the tool that created them. Remove only
# the DDEV project and our config file.
if [[ -n "${CONFIG_WORKTREE:-}" ]] && is_managed_externally "$CONFIG_WORKTREE"; then
    info "Removing DDEV setup from externally managed worktree: ${TARGET_PROJECT} (${TARGET_DIR})"
    (cd "$TARGET_DIR" && ddev delete --omit-snapshot -y 2>/dev/null) || warn "Could not delete DDEV project (may already be removed)"
    rm -f "$CONFIG_WORKTREE"
    echo ""
    success "DDEV project '${TARGET_PROJECT}' removed. Files at ${TARGET_DIR} were left in place."
    echo ""
    exit 0
fi

[[ -z "$ADOPT_PATH" ]] || die "${TARGET_DIR} was not adopted with 'ddev worktree --path'. Remove it by name: ddev worktree-remove ${SANITIZED}"

info "Removing worktree clone: ${TARGET_PROJECT} (${TARGET_DIR})"

# Stop and fully remove DDEV project data (containers, volumes, etc.)
info "Removing DDEV project..."
(cd "$TARGET_DIR" && ddev delete --omit-snapshot -y 2>/dev/null) || warn "Could not delete DDEV project (may already be removed)"

# Check if this is a git worktree
IS_WORKTREE=false
if git -C "$SOURCE_DIR" worktree list 2>/dev/null | grep -q "$(cd "$TARGET_DIR" && pwd)"; then
    IS_WORKTREE=true
fi

if $IS_WORKTREE; then
    info "Removing git worktree..."
    git -C "$SOURCE_DIR" worktree remove --force "$TARGET_DIR" || {
        warn "git worktree remove failed — falling back to manual removal"
        rm -rf "$TARGET_DIR"
        git -C "$SOURCE_DIR" worktree prune 2>/dev/null || true
    }
    success "Git worktree removed"
else
    info "Removing directory..."
    rm -rf "$TARGET_DIR" || die "Failed to remove ${TARGET_DIR}"
    success "Directory removed"
fi

echo ""
success "Worktree clone '${SANITIZED}' removed successfully!"
echo ""
